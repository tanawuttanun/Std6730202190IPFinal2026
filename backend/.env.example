# Copy this file to backend/.env and fill in your values.
# NEVER commit backend/.env (it is in .gitignore) - the GitHub repo is public.
#
# Without DB_HOST / DB_USER / DB_NAME the API uses in-memory data (exam default).

PORT=3000

# Login (optional). Defaults: admin / password123 (exam specification)
# AUTH_USERNAME=admin
# AUTH_PASSWORD=password123

# --- Optional MySQL ---
DB_HOST=119.59.102.161
DB_PORT=3306
DB_USER=std6730202190
DB_PASSWORD=
DB_NAME=ip_std6730202190
DB_TABLE=TanaHom_202190
DB_CONNECT_TIMEOUT_MS=5000

# true = stop the server if MySQL can't be reached
# false (default) = fall back to in-memory data so the API always starts
DB_REQUIRED=false

# true = /api/employees* requires "Authorization: Bearer mock-jwt-token"
REQUIRE_AUTH=false
